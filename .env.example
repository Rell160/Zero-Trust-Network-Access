# ===== Risk-Aware ZTNA System - Environment Variables =====
# Copy this file to .env and set appropriate values

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO
CONFIG_PATH=config/config.yaml

# --- Service Ports ---
RISK_ENGINE_PORT=8001
MFA_SERVER_PORT=8002
ZTNA_CONTROLLER_PORT=8003
PEP_PORT=8000

# --- Security Secrets (CHANGE IN PRODUCTION) ---
JWT_SECRET_KEY=change-me-in-production-use-random-32-chars
MFA_ENCRYPTION_KEY=change-me-in-production-use-random-32-chars
SESSION_SECRET_KEY=change-me-in-production-use-random-32-chars

# --- Database ---
DATABASE_TYPE=sqlite
SQLITE_PATH=ztna_dev.db
# POSTGRES_DSN=postgresql://user:pass@localhost:5432/ztna

# --- Prometheus ---
PROMETHEUS_PORT=9090

# --- Grafana ---
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
